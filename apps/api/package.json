{
  "name": "@sge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@sge/source src/server.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@sge/domain": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
